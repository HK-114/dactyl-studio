#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

/ {
    macros {
        zspace: z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn Z &qcsxxn SPACE &qcsxxn ENTER>;
            label = "Z";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        ctrltab: ctrltab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn LC(TAB)>;
            label = "CTRLTAB";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        hpfx: hpfx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn H &qcsxxn C &qcsxxn P &qcsxxn K &qcsxxn F &qcsxxn J &qcsxxn X &qcsxxn M &qcsxxn SPACE>;
            label = "HPFX";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        tcj: tcj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn T &qcsxxn V &qcsxxn I &qcsxxn A &qcsxxn J &qcsxxn X &qcsxxn SPACE>;
            label = "TCJ";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        bthbc: bthbc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn B &qcsxxn U &qcsxxn T &qcsxxn V &qcsxxn H &qcsxxn O &qcsxxn B &qcsxxn U &qcsxxn I &qcsxxn H &qcsxxn SPACE>;
            label = "BTHBC";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        qcsxxn: QCS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn Y &qcsxxn I &qcsxxn K &qcsxxn D &qcsxxn J &qcsxxn U &qcsxxn COMMA &qcsxxn Q &qcsxxn K &qcsxxn I &qcsxxn A &qcsxxn U &qcsxxn Z &qcsxxn COMMA &qcsxxn X &qcsxxn P &qcsxxn X &qcsxxn P &qcsxxn N &qcsxxn B &qcsxxn EXCL>;
            label = "QCS";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        bz2: bz2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn B &qcsxxn Z &qcsxxn NUMBER_2>;
            label = "BZ2";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        altzz: altzz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn LA(Z)>;
            label = "ALTZZ";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        kfpj: kfpj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn K &qcsxxn E &qcsxxn F &qcsxxn U &qcsxxn P &qcsxxn K &qcsxxn J &qcsxxn X &qcsxxn SPACE>;
            label = "KFPJ";
        };

        fw2: fw2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn F &qcsxxn W &qcsxxn N2>;
            label = "FW2";
        };

        qcs: qcs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&qcsxxn Q &qcsxxn K &qcsxxn I &qcsxxn A &qcsxxn U &qcsxxn Z &qcsxxn COMMA &qcsxxn X &qcsxxn P &qcsxxn X &qcsxxn P &qcsxxn N &qcsxxn B>;
            label = "QCS";
        };
    };

    combos {
        compatible = "zmk,combos";

        df {
            bindings = <&bz2>;
            key-positions = <33 32>;
            timeout-ms = <45>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        sd {
            bindings = <&kfpj>;
            key-positions = <31 32>;
            timeout-ms = <42>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        xc {
            bindings = <&fw2>;
            key-positions = <45 46>;
            timeout-ms = <42>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };

    behaviors {
        hml: howerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOWEROW_MODS_LEFT";
            bindings = <&qcsxxn>, <&qcsxxn>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <21 35 48 36 22 23 37 49 12 13 21 22 23 24 25 26 27 35 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 65 68 69 72 73 7 8 9 10 11 12 13 21 22 23 24 25 26 27 35 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 65 68 69 72 73>;
            hold-trigger-on-release;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&qcsxxn>, <&qcsxxn>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <170>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&qcsxxn ESC     &qcsxxn N1    &qcsxxn N2        &qcsxxn N3  &qcsxxn N4         &qcsxxn N5        &qcsxxn UP_ARROW    &qcsxxn MINUS      &qcsxxn N6        &qcsxxn N7     &qcsxxn N8    &qcsxxn N9      &qcsxxn N0      &qcsxxn BSPC
&qcsxxn TAB     &qcsxxn Q     &qcsxxn W         &qcsxxn E   &qcsxxn R          &qcsxxn T         &qcsxxn DOWN_ARROW  &qcsxxn EQUAL      &qcsxxn Y         &qcsxxn U      &qcsxxn I     &qcsxxn O       &qcsxxn P       &qcsxxn MINUS
&mo 1           &qcsxxn A     &qcsxxn S         &qcsxxn D   &qcsxxn F          &qcsxxn G         &qcsxxn BACKSPACE   &qcsxxn BACKSPACE  &qcsxxn H         &qcsxxn J      &qcsxxn K     &qcsxxn L       &qcsxxn COLON   &qcsxxn EQUAL
&qcsxxn LSHIFT  &hml Z LCTRL  &qcsxxn X         &qcsxxn C   &qcsxxn V          &qcsxxn B                                                &qcsxxn KP_SLASH  &qcsxxn N      &qcsxxn M     &qcsxxn COMMA   &qcsxxn PERIOD  &qcsxxn TILDE
&qcsxxn LCTRL   &qcsxxn N0    &bz2              &altzz      &qcsxxn SPACE      &qcsxxn ENTER                                            &qcsxxn ENTER     &qcsxxn SPACE  &mo 1         &qcsxxn KP_DOT  &mo 2           &mo 3
                              &qcsxxn LEFT_ALT  &mo 1       &qcsxxn BACKSPACE  &qcsxxn LEFT_GUI                                         &mo 3             &mo 2          &qcsxxn LEFT  &qcsxxn RIGHT
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&none  &qcsxxn F1         &qcsxxn F2          &qcsxxn F3          &qcsxxn F4           &qcsxxn F5  &none   &qcsxxn F12  &qcsxxn F6        &qcsxxn F7          &qcsxxn F8          &qcsxxn F9           &qcsxxn F10  &qcsxxn F11
&none  &qcsxxn LA(LC(Q))  &caps_word          &qcsxxn UP_ARROW    &none                &qcsxxn     &bthbc  &none        &none             &none               &qcsxxn UP_ARROW    &none                &none        &qcsxxn F12
&none  &qcsxxn LA(A)      &qcsxxn LEFT_ARROW  &qcsxxn DOWN_ARROW  &qcsxxn RIGHT_ARROW  &tcj        &hpfx   &none        &none             &qcsxxn LEFT_ARROW  &qcsxxn DOWN_ARROW  &qcsxxn RIGHT_ARROW  &none        &none
&none  &none              &none               &none               &zspace              &ctrltab                         &qcsxxn QUESTION  &none               &qcsxxn QUESTION    &none                &none        &none
&none  &none              &none               &none               &none                &none                            &none             &none               &none               &none                &none        &none
                          &none               &qcsxxn BSPC        &qcsxxn BSPC         &none                            &none             &none               &none               &none
            >;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&none             &none             &none          &none  &none  &none  &none  &none  &none         &none         &none                  &none          &none                  &none
&none             &none             &none          &none  &none  &none  &none  &none  &none         &none         &qcsxxn C_VOLUME_UP    &none          &qcsxxn C_VOLUME_UP    &qcsxxn C_PREVIOUS
&qcsxxn C_BRI_UP  &qcsxxn C_BRI_DN  &none          &none  &none  &none  &none  &none  &qcsxxn LEFT  &qcsxxn DOWN  &qcsxxn C_VOLUME_DOWN  &qcsxxn RIGHT  &qcsxxn C_VOLUME_DOWN  &qcsxxn C_NEXT
&none             &none             &none          &none  &none  &none                &none         &none         &none                  &none          &qcsxxn C_PLAY_PAUSE   &none
&none             &none             &none          &none  &none  &none                &none         &none         &none                  &none          &none                  &none
                                    &qcsxxn LSHFT  &none  &none  &none                &qcsxxn C_RW  &qcsxxn C_FF  &none                  &none
            >;
        };

        hotkey_layer {
            label = "HOTKEY";
            bindings = <
&bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &bt BT_CLR    &none  &out OUT_USB  &none         &none  &none         &none         &none
&none              &none         &none         &none         &none         &none  &out OUT_USB  &none  &bt BT_SEL 0  &bt BT_SEL 1  &none  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none              &none         &none         &none         &none         &none  &out OUT_BLE  &none  &out OUT_USB  &none         &none  &none         &none         &none
&qcsxxn BACKSPACE  &none         &none         &none         &none         &none                       &out OUT_BLE  &none         &none  &none         &none         &qcsxxn BACKSPACE
&none              &none         &none         &bootloader   &none         &none                       &none         &none         &none  &none         &none         &qcsxxn B
                                 &none         &none         &none         &none                       &none         &none         &none  &none
            >;
        };
    };
};
