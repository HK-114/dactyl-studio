#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

/ {
    macros {
        zspace: z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp SPACE &kp ENTER>;
            label = "Z";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        ctrltab: ctrltab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>;
            label = "CTRLTAB";
            wait-ms = <50>;
            tap-ms = <50>;
        };

        hpfx: hpfx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp C &kp P &kp K &kp F &kp J &kp X &kp M &kp SPACE>;
            label = "HPFX";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        tcj: tcj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp V &kp I &kp A &kp J &kp X &kp SPACE>;
            label = "TCJ";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        bthbc: bthbc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp U &kp T &kp V &kp H &kp O &kp B &kp U &kp I &kp H &kp SPACE>;
            label = "BTHBC";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        bz2: bz2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp Z &kp N2>;
            label = "BZ2";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        altzz: altzz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(Z)>;
            label = "ALTZZ";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        kfpj: kfpj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K &kp E &kp F &kp U &kp P &kp K &kp J &kp X &kp SPACE>;
            label = "KFPJ";
        };

        fw2: fw2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp W &kp N2>;
            label = "FW2";
        };

        qcs: qcs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp K &kp I &kp A &kp U &kp Z &kp COMMA &kp X &kp P &kp X &kp P &kp N &kp B &kp SPACE>;
            label = "QCS";
        };

        fap: fap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp I &kp K &kp D &kp J &kp U &kp COMMA &kp Q &kp K &kp I &kp A &kp U &kp Z &kp COMMA &kp X &kp P &kp X &kp P &kp N &kp B &kp SPACE>;
            label = "FAP";
        };
    };

    combos {
        compatible = "zmk,combos";

        df {
            bindings = <&bz2>;
            key-positions = <33 32>;
            timeout-ms = <45>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        sd {
            bindings = <&kfpj>;
            key-positions = <31 32>;
            timeout-ms = <42>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        xc {
            bindings = <&fw2>;
            key-positions = <45 46>;
            timeout-ms = <42>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };

    behaviors {
        hml: howerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOWEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <21 35 48 36 22 23 37 49 12 13 21 22 23 24 25 26 27 35 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 65 68 69 72 73 7 8 9 10 11 12 13 21 22 23 24 25 26 27 35 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 65 68 69 72 73>;
            hold-trigger-on-release;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <170>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        zero {
            label = "DEFAULT";
            bindings = <
&kp ESC    &kp N1               &kp N2  &kp N3  &kp N4        &kp N5        &none  &none  &kp N6     &kp N7         &kp N8        &kp N9          &kp N0            &kp BACKSPACE
&kp ESC    &kp Q                &kp W   &kp E   &kp R         &kp T         &none  &none  &kp Y      &kp U          &kp I         &kp P           &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&mo 1      &kp A                &kp S   &kp D   &kp F         &kp G         &none  &none  &kp H      &kp J          &kp K         &kp L           &kp SEMICOLON     &kp DOUBLE_QUOTES
&kp TAB    &kp Z                &kp X   &kp C   &kp V         &kp B                       &kp SLASH  &kp N          &kp M         &kp COMMA       &kp PERIOD        &kp DELETE
&kp LCTRL  &hml LEFT_ALT LCTRL  &bz2    &altzz  &kp LEFT_ALT  &kp SPACE                   &kp ENTER  &kp BACKSPACE  &mo 1         &kp KP_DOT      &mo 2             &mo 3
                                &none   &mo 1   &kp LEFT_GUI  &kp CAPSLOCK                &mo 3      &mo 2          &kp UP_ARROW  &kp DOWN_ARROW
            >;
        };

        one {
            label = "NUMBER";
            bindings = <
&none   &none   &none           &none           &none            &none          &none    &none  &none      &none   &none   &none   &none  &none
&kp N0  &kp N1  &kp N2          &kp N3          &kp N4           &kp N5         &kp ESC  &none  &kp MINUS  &kp N7  &kp N8  &kp N9  &none  &none
&none   &none   &kp LC(N2)      &kp UP_ARROW    &none            &kp BACKSPACE  &hpfx    &none  &kp EQUAL  &kp N4  &kp N5  &kp N6  &none  &none
&none   &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &ctrltab                       &kp DOT    &kp N1  &kp N2  &kp N3  &none  &none
&none   &none   &none           &none           &none            &none                          &kp N0     &none   &none   &none   &none  &none
                &none           &none           &kp ENTER        &none                          &none      &none   &none   &none
            >;
        };

        two {
            label = "SYMBOL";
            bindings = <
&kp A  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
              &none  &none  &none  &none                &none  &none  &none  &none
            >;
        };

        three {
            label = "HOTKEY";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &bt BT_CLR    &none  &out OUT_USB  &none         &none  &none         &none         &none
&none         &none         &none         &none         &none         &none  &out OUT_USB  &none  &bt BT_SEL 0  &bt BT_SEL 1  &none  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none         &none         &none         &none         &none         &none  &out OUT_BLE  &none  &out OUT_USB  &none         &none  &none         &none         &none
&none         &none         &none         &none         &none         &none                       &out OUT_BLE  &none         &none  &none         &none         &none
&none         &none         &none         &bootloader   &none         &none                       &none         &none         &none  &none         &none         &none
                            &none         &none         &none         &none                       &none         &none         &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
            >;
        };
    };
};
